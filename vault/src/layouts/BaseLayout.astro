---
import "../styles/global.css";
import { discussionsUrl } from "../lib/forum";

type Props = {
  title: string;
  description?: string;
  updated?: string;
  /** wider content container (used by the builder) */
  wide?: boolean;
};

const { title, description, updated, wide } = Astro.props;
const siteRef = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname + Astro.url.search, siteRef);

const baseHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : null}
    <link rel="canonical" href={canonical.toString()} />
    <title>{title}</title>
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="vault-body">
    <header class="vault-header">
      <div class="vault-inner">
        <a class="vault-brand" href={baseHref}>{`Vault · public MDX`}</a>
        <nav aria-label="ניווט" class="vault-nav">
          <a href={baseHref}>בית</a>
          <a href={`${baseHref}forum/`}>פורום</a>
          <a href={`${baseHref}build/`}>צור עמוד</a>
          {
            discussionsUrl ? (
              <a href={discussionsUrl} target="_blank" rel="noreferrer noopener">
                דיונים ↗
              </a>
            ) : null
          }
        </nav>
      </div>
    </header>
    <main class="vault-main">
      <div class={`vault-inner${wide ? " vault-inner-wide" : ""}`}>
        {
          updated ? (
            <p class="vault-updated">
              עודכן: <time datetime={updated}>{updated}</time>
            </p>
          ) : null
        }
        <slot />
      </div>
    </main>
    <footer class="vault-footer">
      <div class="vault-inner vault-footer-copy">
        Contribute via Pull Request · Isolated from CoreStrategy production backends
      </div>
    </footer>
  </body>
</html>
