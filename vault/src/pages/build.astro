---
import StudioLayout from "../layouts/StudioLayout.astro";
import StudioApp from "../vault-engine/StudioApp";

const baseHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const repoUrl = import.meta.env.PUBLIC_GITHUB_REPO_URL ?? "";
---

<StudioLayout title="בניית עמוד · Vault Studio">
  <StudioApp
    client:only="react"
    previewSrc={`${baseHref}build/preview/`}
    repoUrl={repoUrl}
    homeHref={baseHref}
  />
</StudioLayout>
