---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlockRenderer from "../../vault-engine/BlockRenderer";
import "../../styles/blocks.css";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("pages", ({ data }) => data.draft !== true);
  return items.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <BlockRenderer
    client:load
    blocks={entry.data.blocks}
    palettes={entry.data.palettes ?? {}}
  />
</BaseLayout>
