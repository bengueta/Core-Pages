---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="לא נמצא · Vault"
  description="העמוד שביקשת לא זמין ב-Vault הציבורי."
>
  <h1 style="margin-top: 0">העמוד לא נמצא</h1>
  <p class="vault-card-summary">
    חזרו לרשימה המלאה מתוך העמוד הראשי הסטטי של האתר.
  </p>
  <p>
    <a href={baseHref}>חזרה לראש</a>
  </p>
</BaseLayout>
